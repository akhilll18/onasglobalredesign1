<file path="src/components/SolutionsServices.jsx">
import React from 'react';
import { Box, Typography, Container, Grid, Card, CardContent, CardMedia, Button } from '@mui/material';
import { Link as RouterLink } from 'react-router-dom';
import { motion } from 'framer-motion';
import ArrowForwardIcon from '@mui/icons-material/ArrowForward';

const SolutionsServices = ({ 
  services, 
  title = "Our Solutions", 
  subtitle = "A comprehensive suite for e-Documents, VAT Reports and Reconciliation" 
}) => {
  return (
    <Container maxWidth="lg" sx={{ mb: 4 }}>
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
        <Box>
          <Typography
            variant="h4"
            fontWeight={600}
            sx={{
              color: '#0B4C74',
              fontSize: { xs: '22px', md: '28px' },
            }}
          >
            {title}
          </Typography>
          <Typography variant="body2" sx={{ color: '#666' }}>
            {subtitle}
          </Typography>
        </Box>
        <Button
          component={RouterLink}
          to="/solutions"
          endIcon={<ArrowForwardIcon />}
          sx={{
            color: '#2E8BC0',
            fontWeight: 600,
            textTransform: 'none',
            '&:hover': { bgcolor: 'transparent' },
          }}
        >
          Explore More →
        </Button>
      </Box>

      <Grid container spacing={3}>
        {services.map((service, index) => (
          <Grid item xs={12} sm={6} md={3} key={index}>
            <motion.div
              initial={{ opacity: 0, y: 40 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.6, delay: index * 0.1 }}
              whileHover={{ scale: 1.03 }}
              style={{ height: '100%' }}
            >
              <Card
                sx={{
                  height: '100%',
                  minHeight: 280,
                  borderRadius: 3,
                  overflow: 'hidden',
                  boxShadow: '0 4px 20px rgba(0,0,0,0.06)',
                  transition: 'all 0.3s ease',
                  cursor: 'pointer',
                  '&:hover': {
                    boxShadow: '0 12px 40px rgba(0,0,0,0.1)',
                  },
                }}
                component={RouterLink}
                to={service.path}
                style={{ textDecoration: 'none' }}
              >
                <CardMedia
                  component="img"
                  image={service.image}
                  alt={service.title}
                  sx={{ height: 160, objectFit: 'cover' }}
                />
                <CardContent sx={{ textAlign: 'center', p: 2.5 }}>
                  <Typography
                    variant="h6"
                    fontWeight={600}
                    sx={{
                      color: '#0B4C74',
                      mb: 1,
                      fontSize: '16px',
                    }}
                  >
                    {service.title}
                  </Typography>
                  <Typography 
                    variant="body2" 
                    sx={{ 
                      color: '#666', 
                      lineHeight: 1.6, 
                      fontSize: '13px',
                      display: '-webkit-box',
                      WebkitLineClamp: 2,
                      WebkitBoxOrient: 'vertical',
                      overflow: 'hidden',
                      textOverflow: 'ellipsis',
                    }}
                  >
                    {service.description}
                  </Typography>
                </CardContent>
              </Card>
            </motion.div>
          </Grid>
        ))}
      </Grid>
    </Container>
  );
};

export default SolutionsServices;
